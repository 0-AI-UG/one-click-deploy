{
  "$schema": 1,
  "name": "API Server",
  "description": "REST API backend using stack-injected service URLs",
  "build": {
    "repository": "https://github.com/example/blog.git",
    "branch": "main",
    "dockerfile": "services/api/Dockerfile",
    "context": ".",
    "image": "ghcr.io/example/blog-api",
    "webhook": true
  },
  "container_port": 8080,
  "env": [
    { "key": "JWT_SECRET", "description": "Signing key for auth tokens", "required": true, "secret": true },
    { "key": "LOG_LEVEL", "default": "info" }
  ],
  "volume": null,
  "health_check": { "path": "/health" },
  "suggested_app_name": "blog-api"
}
