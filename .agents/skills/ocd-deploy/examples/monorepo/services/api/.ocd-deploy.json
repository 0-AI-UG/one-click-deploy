{
  "$schema": 1,
  "name": "API Server",
  "description": "REST API backend using stack dependency URLs",
  "build": {
    "repository": "https://git.example.com/team/blog.git",
    "branch": "main",
    "dockerfile": "services/api/Dockerfile",
    "context": ".",
    "image_repository": "registry.example.com/team/blog-api",
    "webhook": false
  },
  "container_port": 8080,
  "env": {
    "JWT_SECRET": {
      "from": "environment.JWT_SECRET"
    },
    "LOG_LEVEL": "info",
    "DATABASE_URL": {
      "from": "apps.database.outputs.URL"
    },
    "REDIS_URL": {
      "from": "apps.redis.outputs.URL"
    }
  },
  "volume": null,
  "health_check": {
    "path": "/health"
  },
  "suggested_app_name": "blog-api",
  "outputs": {
    "URL": {
      "template": "http://{app.host}:{app.port}"
    }
  }
}
