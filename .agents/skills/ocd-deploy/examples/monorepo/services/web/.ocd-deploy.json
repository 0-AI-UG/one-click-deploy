{
  "$schema": 1,
  "name": "Web Frontend",
  "description": "Web frontend using the stack-injected API_URL",
  "build": {
    "repository": "https://git.example.com/team/blog.git",
    "branch": "main",
    "dockerfile": "services/web/Dockerfile",
    "context": ".",
    "image_repository": "registry.example.com/team/blog-web",
    "webhook": false
  },
  "container_port": 80,
  "env": [
    { "key": "NODE_ENV", "default": "production" }
  ],
  "volume": null,
  "suggested_app_name": "blog-web",
  "compress": true
}
