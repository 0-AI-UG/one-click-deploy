{
  "$schema": 1,
  "name": "blog",
  "services": {
    "database": { "type": "postgresql", "volume_size": 10 },
    "redis": { "type": "redis" }
  },
  "apps": {
    "api": {
      "manifest": "services/api/.ocd-deploy.json",
      "needs": ["database", "redis"],
      "env": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "LOG_LEVEL"]
    },
    "web": {
      "manifest": "services/web/.ocd-deploy.json",
      "needs": ["api"],
      "env": ["API_URL", "NODE_ENV"],
      "public": true
    }
  }
}
