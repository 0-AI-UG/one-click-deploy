{
  "type": "redis",
  "label": "Redis",
  "image": "redis",
  "versions": ["7-alpine", "7", "6-alpine"],
  "defaultPort": 6379,
  "requiredEnvVars": [
    { "key": "REDIS_PASSWORD", "label": "Password", "generate": "password" }
  ],
  "volumePath": "/data",
  "healthCmd": "redis-cli ping",
  "defaultVolumeSize": 5,
  "connectionUrlTemplate": "redis://:{REDIS_PASSWORD}@{host}:{port}",
  "icon": "Re",
  "color": "bg-red-500"
}
