{
  "type": "minio",
  "label": "MinIO",
  "image": "minio/minio",
  "versions": ["latest", "RELEASE.2024-10-29T16-01-48Z"],
  "defaultPort": 9000,
  "requiredEnvVars": [
    { "key": "MINIO_ROOT_USER", "label": "Root Username", "generate": "username" },
    { "key": "MINIO_ROOT_PASSWORD", "label": "Root Password", "generate": "password" }
  ],
  "volumePath": "/data",
  "cmd": ["server", "/data", "--console-address", ":9001"],
  "healthCmd": "mc ready local",
  "defaultVolumeSize": 50,
  "connectionUrlTemplate": "http://{MINIO_ROOT_USER}:{MINIO_ROOT_PASSWORD}@{host}:{port}",
  "icon": "Mn",
  "color": "bg-amber-600",
  "category": "storage",
  "description": "S3-compatible object storage"
}
