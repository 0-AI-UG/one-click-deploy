{
  "type": "flowise",
  "label": "Flowise",
  "image": "flowiseai/flowise",
  "versions": ["latest", "2.2.4", "2.1.5"],
  "defaultPort": 3000,
  "requiredEnvVars": [
    { "key": "FLOWISE_USERNAME", "label": "Username", "generate": "username" },
    { "key": "FLOWISE_PASSWORD", "label": "Password", "generate": "password" },
    { "key": "DATABASE_PATH", "label": "Database Path", "default": "/root/.flowise" }
  ],
  "volumePath": "/root/.flowise",
  "healthCmd": "wget -qO- http://127.0.0.1:3000/api/v1/ping",
  "defaultVolumeSize": 10,
  "connectionUrlTemplate": "http://{host}:{port}",
  "icon": "Fl",
  "color": "bg-cyan-600",
  "http": true,
  "description": "Visual LLM app builder (LangChain-based)",
  "category": "ai"
}
