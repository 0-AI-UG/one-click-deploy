{
  "type": "meilisearch",
  "label": "Meilisearch",
  "image": "getmeili/meilisearch",
  "versions": ["v1.11", "v1.10", "v1.9"],
  "defaultPort": 7700,
  "requiredEnvVars": [
    { "key": "MEILI_MASTER_KEY", "label": "Master Key", "generate": "password" },
    { "key": "MEILI_ENV", "label": "Environment", "default": "production" }
  ],
  "volumePath": "/meili_data",
  "healthCmd": "bash -c 'exec 3<>/dev/tcp/127.0.0.1/7700'",
  "defaultVolumeSize": 10,
  "connectionUrlTemplate": "http://{host}:{port}",
  "icon": "Me",
  "color": "bg-pink-500",
  "category": "search",
  "description": "Lightweight full-text search"
}
