{
  "type": "authentik",
  "label": "Authentik",
  "image": "ghcr.io/goauthentik/server",
  "versions": ["2025.10", "2025.8", "2025.12"],
  "defaultPort": 9000,
  "requiredEnvVars": [
    { "key": "AUTHENTIK_BOOTSTRAP_EMAIL", "label": "Admin Email", "default": "akadmin@authentik.local" }
  ],
  "secrets": [
    { "key": "PG_PASS", "generate": "password" },
    { "key": "AUTHENTIK_SECRET_KEY", "generate": "secret-key" },
    { "key": "AUTHENTIK_BOOTSTRAP_PASSWORD", "generate": "password" },
    { "key": "AUTHENTIK_BOOTSTRAP_TOKEN", "generate": "token" }
  ],
  "volumePath": "",
  "healthCmd": "",
  "defaultVolumeSize": 10,
  "connectionUrlTemplate": "https://{host}",
  "icon": "Ak",
  "color": "bg-orange-600",
  "http": true,
  "description": "Identity provider & SSO — social login, password, passkey, MFA",
  "category": "auth",
  "compose": "authentik.yml",
  "composeWebService": "server",
  "composeWebPort": 9000,
  "versionEnvKey": "AUTHENTIK_TAG",
  "volumeSubpaths": [
    { "service": "postgresql", "subpath": "database", "container": "/var/lib/postgresql/data" },
    { "service": "redis", "subpath": "redis", "container": "/data" },
    { "service": "server", "subpath": "media", "container": "/media" },
    { "service": "worker", "subpath": "media", "container": "/media" }
  ],
  "surfaceCredentials": {
    "admin_username": "AUTHENTIK_BOOTSTRAP_EMAIL",
    "admin_email": "AUTHENTIK_BOOTSTRAP_EMAIL",
    "admin_password": "AUTHENTIK_BOOTSTRAP_PASSWORD",
    "admin_token": "AUTHENTIK_BOOTSTRAP_TOKEN"
  },
  "minServerType": "cx32",
  "recommendedMemoryMb": 2048
}
