{
  "type": "postgresql",
  "label": "PostgreSQL",
  "image": "postgres",
  "versions": [
    "17-alpine",
    "17-pgvector-postgis-pgmq",
    "17-pgvector",
    "17-postgis",
    "17-pgmq",
    "16-alpine",
    "15-alpine",
    "14-alpine"
  ],
  "variants": {
    "17-pgvector-postgis-pgmq": {
      "image": "nhost/postgres",
      "tag": "17.10-20260610-1",
      "defaultEnvVars": { "POSTGRES_EXTENSIONS": "vector,postgis,pgmq" }
    },
    "17-pgvector": {
      "image": "pgvector/pgvector",
      "tag": "pg17",
      "defaultEnvVars": { "POSTGRES_EXTENSIONS": "vector" }
    },
    "17-postgis": {
      "image": "postgis/postgis",
      "tag": "17-3.5",
      "defaultEnvVars": { "POSTGRES_EXTENSIONS": "postgis" }
    },
    "17-pgmq": {
      "image": "ghcr.io/pgmq/pg17-pgmq",
      "tag": "v1.11.1",
      "defaultEnvVars": { "POSTGRES_EXTENSIONS": "pgmq" }
    }
  },
  "defaultPort": 5432,
  "defaultEnvVars": {
    "PGDATA": "/var/lib/postgresql/data/pgdata"
  },
  "requiredEnvVars": [
    { "key": "POSTGRES_USER", "label": "Username", "default": "postgres" },
    { "key": "POSTGRES_PASSWORD", "label": "Password", "generate": "password" },
    { "key": "POSTGRES_DB", "label": "Database", "default": "app" },
    { "key": "POSTGRES_EXTENSIONS", "label": "Extensions (comma-separated)" }
  ],
  "volumePath": "/var/lib/postgresql/data",
  "extraCaps": ["CHOWN", "SETUID", "SETGID"],
  "healthCmd": "pg_isready",
  "postStartCmd": "set -f; old_ifs=$IFS; IFS=,; for extension in $POSTGRES_EXTENSIONS; do extension=$(printf \"%s\" \"$extension\" | tr -d \"[:space:]\"); [ -z \"$extension\" ] && continue; case \"$extension\" in *[!A-Za-z0-9_-]*) echo \"Invalid extension name: $extension\"; exit 1 ;; esac; psql -v ON_ERROR_STOP=1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"CREATE EXTENSION IF NOT EXISTS \\\"$extension\\\"\" || exit 1; done; IFS=$old_ifs; set +f",
  "defaultVolumeSize": 10,
  "connectionUrlTemplate": "postgresql://{POSTGRES_USER}:{POSTGRES_PASSWORD}@{host}:{port}/{POSTGRES_DB}",
  "icon": "PG",
  "color": "bg-blue-600",
  "category": "database",
  "description": "Relational database"
}
