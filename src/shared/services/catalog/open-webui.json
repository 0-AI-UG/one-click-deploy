{
  "type": "open-webui",
  "label": "Open WebUI",
  "image": "ghcr.io/open-webui/open-webui",
  "versions": ["main", "v0.5.2", "v0.4.8"],
  "defaultPort": 8080,
  "requiredEnvVars": [
    { "key": "WEBUI_SECRET_KEY", "label": "Secret Key", "generate": "password" }
  ],
  "volumePath": "/app/backend/data",
  "healthCmd": "curl -fs http://127.0.0.1:8080/health",
  "defaultVolumeSize": 20,
  "connectionUrlTemplate": "http://{host}:{port}",
  "icon": "Ow",
  "color": "bg-slate-700",
  "http": true,
  "description": "ChatGPT-style UI for local + remote LLMs",
  "category": "ai"
}
