{
  "type": "n8n",
  "label": "n8n",
  "image": "n8nio/n8n",
  "versions": ["latest", "1.70.0", "1.65.0"],
  "defaultPort": 5678,
  "requiredEnvVars": [
    { "key": "N8N_BASIC_AUTH_ACTIVE", "label": "Basic Auth", "default": "false" },
    { "key": "GENERIC_TIMEZONE", "label": "Timezone", "default": "UTC" }
  ],
  "volumePath": "/home/node/.n8n",
  "healthCmd": "wget -qO- http://127.0.0.1:5678/healthz || exit 1",
  "defaultVolumeSize": 10,
  "connectionUrlTemplate": "http://{host}:{port}",
  "icon": "n8",
  "color": "bg-fuchsia-600",
  "http": true,
  "description": "Workflow automation for technical teams",
  "category": "ai"
}
