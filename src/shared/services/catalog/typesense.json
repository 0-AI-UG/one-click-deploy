{
  "type": "typesense",
  "label": "Typesense",
  "image": "typesense/typesense",
  "versions": ["28.0", "27.1", "26.0"],
  "defaultPort": 8108,
  "requiredEnvVars": [
    { "key": "TYPESENSE_API_KEY", "label": "API Key", "generate": "password" },
    { "key": "TYPESENSE_DATA_DIR", "label": "Data Directory", "default": "/data" },
    { "key": "TYPESENSE_ENABLE_CORS", "label": "Enable CORS", "default": "true" }
  ],
  "volumePath": "/data",
  "healthCmd": "exec 3<>/dev/tcp/127.0.0.1/8108",
  "defaultVolumeSize": 10,
  "connectionUrlTemplate": "http://{host}:{port}",
  "icon": "Ts",
  "color": "bg-indigo-600"
}
