{
  "$schema": 1,
  "name": "Web Frontend",
  "description": "React SPA served by nginx. In a stack it reads API_URL from the shared environment (injected automatically because it `needs` the `api` app), so API_URL is NOT declared here.",
  "build": { "dockerfile": "Dockerfile", "context": ".", "container_port": 80 },
  "env": [
    { "key": "NODE_ENV", "default": "production" }
  ],
  "webhook": { "enabled": true, "branch": "main", "path": "services/web" },
  "suggested_app_name": "myapp-web",
  "compress": true
}
