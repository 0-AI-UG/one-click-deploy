{
  "$schema": 1,
  "name": "Web Frontend",
  "description": "React SPA served by nginx. Its container entrypoint renders API_URL from the runtime environment into a browser-readable config file; API_URL is injected by the stack and is not declared here.",
  "build": { "dockerfile": "Dockerfile", "context": ".", "container_port": 80 },
  "env": [
    { "key": "NODE_ENV", "default": "production" }
  ],
  "volume": null,
  "webhook": { "enabled": true, "branch": "main", "paths": ["services/web/**"] },
  "suggested_app_name": "myapp-web",
  "compress": true
}
