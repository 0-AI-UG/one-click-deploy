{
  "$schema": 1,
  "name": "My App",
  "description": "A Node.js web application",
  "build": {
    "repository": "https://github.com/example/my-app.git",
    "branch": "main",
    "dockerfile": "Dockerfile",
    "context": ".",
    "image": "ghcr.io/example/my-app",
    "webhook": true
  },
  "container_port": 3000,
  "env": [
    { "key": "DATABASE_URL", "description": "Postgres connection string", "required": true, "secret": true },
    { "key": "NODE_ENV", "default": "production" }
  ],
  "volume": { "size": 5, "path": "/data" },
  "health_check": { "path": "/healthz" },
  "suggested_app_name": "my-app",
  "replicas": 1,
  "memory_mb": 512,
  "cpu_limit": 1
}
