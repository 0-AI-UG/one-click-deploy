{
  "$schema": 1,
  "name": "My App",
  "description": "A Node.js web application",
  "build": {
    "repository": "https://git.example.com/team/my-app.git",
    "branch": "main",
    "dockerfile": "Dockerfile",
    "context": ".",
    "image_repository": "registry.example.com/team/my-app",
    "webhook": false
  },
  "container_port": 3000,
  "env": {
    "DATABASE_URL": {
      "from": "environment.DATABASE_URL"
    },
    "NODE_ENV": "production"
  },
  "volume": {
    "size": 5,
    "path": "/data"
  },
  "health_check": {
    "path": "/healthz"
  },
  "suggested_app_name": "my-app",
  "replicas": 1,
  "memory_mb": 512,
  "cpu_limit": 1,
  "environment": "production"
}
