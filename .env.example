# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Required in production (NODE_ENV=production). In dev a hardcoded default is used.
JWT_SECRET=

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Set to 1 only when the server is behind a trusted reverse proxy (Caddy, nginx)
# that sets X-Forwarded-For. Leaving this unset (or 0) prevents IP spoofing via
# forged headers — the server falls back to Bun's native requestIP() instead.
TRUST_PROXY=0
