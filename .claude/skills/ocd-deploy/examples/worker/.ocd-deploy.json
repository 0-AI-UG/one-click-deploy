{
  "$schema": 1,
  "name": "Queue Worker",
  "description": "Background job worker that speaks no HTTP",
  "build": {
    "repository": "https://git.example.com/team/worker.git",
    "branch": "main",
    "dockerfile": "Dockerfile",
    "context": ".",
    "image_repository": "registry.example.com/team/worker",
    "webhook": false
  },
  "env": {
    "REDIS_URL": {
      "from": "environment.REDIS_URL"
    },
    "CONCURRENCY": "4"
  },
  "volume": null,
  "public": false,
  "health_check": {
    "mode": "container"
  },
  "suggested_app_name": "myapp-worker",
  "environment": "production"
}
