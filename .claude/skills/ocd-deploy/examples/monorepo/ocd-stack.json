{
  "$schema": 1,
  "name": "blog",
  "apps": {
    "database": {
      "manifest": "infrastructure/database/.ocd-deploy.json"
    },
    "redis": {
      "manifest": "infrastructure/redis/.ocd-deploy.json"
    },
    "api": {
      "manifest": "services/api/.ocd-deploy.json",
      "needs": [
        "database",
        "redis"
      ]
    },
    "web": {
      "manifest": "services/web/.ocd-deploy.json",
      "needs": [
        "api"
      ],
      "public": true
    }
  },
  "environment": "production"
}
