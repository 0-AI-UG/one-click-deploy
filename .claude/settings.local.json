{
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bun tsc:*)",
      "Bash(bun x:*)",
      "Bash(npx tsc *)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(stripe products *)",
      "Bash(git *)",
      "Bash(ocd ssh *)"
    ]
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anton/.cate/agent-hooks/cate-hook-bridge-claude-code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anton/.cate/agent-hooks/cate-hook-bridge-claude-code"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anton/.cate/agent-hooks/cate-hook-bridge-claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anton/.cate/agent-hooks/cate-hook-bridge-claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anton/.cate/agent-hooks/cate-hook-bridge-claude-code"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anton/.cate/agent-hooks/cate-hook-bridge-claude-code"
          }
        ]
      }
    ]
  }
}
