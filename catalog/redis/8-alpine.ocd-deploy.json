{
  "$schema": 1,
  "name": "Redis 8",
  "description": "Redis 8 on Alpine as an image-backed OCD app.",
  "image": "redis:8-alpine",
  "container_port": 6379,
  "env": {
    "REDIS_PASSWORD": {
      "from": "environment.REDIS_PASSWORD"
    }
  },
  "command": [
    "sh",
    "-ec",
    "exec docker-entrypoint.sh redis-server --appendonly yes --requirepass \"$REDIS_PASSWORD\""
  ],
  "cap_add": [
    "CHOWN",
    "SETUID",
    "SETGID"
  ],
  "internal_protocol": "tcp",
  "public": false,
  "health_check": {
    "mode": "exec",
    "command": "redis-cli -a \"$REDIS_PASSWORD\" ping"
  },
  "volume": {
    "size": 10,
    "path": "/data"
  },
  "outputs": {
    "URL": {
      "template": "redis://:{env.REDIS_PASSWORD}@{app.host}:{app.port}",
      "secret": true
    },
    "HOST": {
      "template": "{app.host}"
    },
    "PORT": {
      "template": "{app.port}"
    },
    "PASSWORD": {
      "template": "{env.REDIS_PASSWORD}",
      "secret": true
    }
  }
}
