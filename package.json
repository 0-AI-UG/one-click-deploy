{
  "name": "one-click-deploy",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "start": "OCD_MODE=server bun run src/server/index.ts",
    "engine": "OCD_MODE=engine bun run src/engine/entrypoint.ts",
    "engine:dev": "OCD_MODE=engine bun run src/engine/entrypoint.ts",
    "dev": "OCD_MODE=server SKIP_2FA=1 bun --watch run src/server/index.ts",
    "build": "bun build src/web/index.html --outdir=src/web/dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "test:integration": "RUN_INTEGRATION=1 bun test src/integration/",
    "test:integration:engine": "RUN_INTEGRATION=1 bun test src/integration/engine-ops.test.ts",
    "bootstrap": "bun run scripts/bootstrap.ts",
    "build:cli": "bun build src/cli/main.ts --compile --target=bun-linux-x64 --outfile=dist/cli/ocd-linux-x64 && bun build src/cli/main.ts --compile --target=bun-linux-arm64 --outfile=dist/cli/ocd-linux-arm64 && bun build src/cli/main.ts --compile --target=bun-darwin-x64 --outfile=dist/cli/ocd-darwin-x64 && bun build src/cli/main.ts --compile --target=bun-darwin-arm64 --outfile=dist/cli/ocd-darwin-arm64 && bun build src/cli/main.ts --compile --target=bun-windows-x64 --outfile=dist/cli/ocd-windows-x64.exe"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
