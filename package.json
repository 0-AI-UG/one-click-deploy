{
  "name": "one-click-deploy",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "start": "OCD_MODE=server bun run src/server/index.ts",
    "dev": "OCD_MODE=server SKIP_2FA=1 bun --watch run src/server/index.ts",
    "build": "bun build src/web/index.html --outdir=src/web/dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/bun/",
    "bootstrap": "bun run scripts/bootstrap.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "otpauth": "^9.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
