{
  "$schema": 1,
  "name": "Shared PostgreSQL backups",
  "description": "Bun service backing up every database to OCD-managed nbg1 storage with encryption and download verification.",
  "container_port": 3000,
  "public": false,
  "volume": null,
  "replicas": 1,
  "memory_mb": 1024,
  "env": [
    {
      "key": "BACKUP_DATABASE_URL",
      "required": true,
      "secret": true
    },
    {
      "key": "BACKUP_ENCRYPTION_KEY",
      "generate": "password",
      "secret": true
    },
    {
      "key": "OCD_STORAGE_URL",
      "required": true
    },
    {
      "key": "OCD_STORAGE_TOKEN",
      "required": true,
      "secret": true
    },
    {
      "key": "BACKUP_PREFIX",
      "default": "shared-postgres"
    },
    {
      "key": "BACKUP_INTERVAL_SECONDS",
      "default": "21600"
    }
  ],
  "health_check": {
    "mode": "exec",
    "command": "bun run /app/backup.ts --health"
  },
  "image": "ghcr.io/0-ai-ug/ocd-postgres-backup@sha256:1234da893fc0f0dd926fd7fb3c3d4ec34448bb1ae9c1d7dcb937b1805fa49a33",
  "environment": "shared-data",
  "env_projection": [
    "BACKUP_DATABASE_URL",
    "BACKUP_ENCRYPTION_KEY",
    "OCD_STORAGE_URL",
    "OCD_STORAGE_TOKEN",
    "BACKUP_PREFIX",
    "BACKUP_INTERVAL_SECONDS"
  ]
}