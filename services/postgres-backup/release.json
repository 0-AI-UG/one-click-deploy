{
  "$schema": 1,
  "name": "Shared PostgreSQL backups",
  "description": "Bun service backing up every database to OCD-managed nbg1 storage with encryption and download verification.",
  "container_port": 3000,
  "public": false,
  "volume": null,
  "replicas": 1,
  "memory_mb": 1024,
  "env": {
    "BACKUP_DATABASE_URL": {
      "from": "environment.BACKUP_DATABASE_URL"
    },
    "BACKUP_ENCRYPTION_KEY": {
      "from": "environment.BACKUP_ENCRYPTION_KEY"
    },
    "BACKUP_PREFIX": {
      "from": "environment.BACKUP_PREFIX"
    },
    "BACKUP_INTERVAL_SECONDS": {
      "from": "environment.BACKUP_INTERVAL_SECONDS"
    }
  },
  "health_check": {
    "mode": "exec",
    "command": "bun run /app/backup.ts --health"
  },
  "image": "ghcr.io/0-ai-ug/ocd-postgres-backup@sha256:1234da893fc0f0dd926fd7fb3c3d4ec34448bb1ae9c1d7dcb937b1805fa49a33",
  "environment": "shared-data",
  "storage": {
    "primary": {
      "connection": "s3-compatible-3206399b",
      "bucket": "ocd-ceroai-backups",
      "prefix": "",
      "permissions": [
        "read",
        "write"
      ]
    }
  }
}
