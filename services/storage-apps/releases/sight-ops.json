{
  "$schema": 1,
  "name": "Sight Operations Worker",
  "description": "Private singleton for durable delivery, billing recovery, recurring schedules, onboarding, and housekeeping.",
  "container_port": 3000,
  "env": [
    {
      "key": "OCD_DEPLOY_TARGET",
      "default": "production"
    },
    {
      "key": "NODE_ENV",
      "default": "production"
    },
    {
      "key": "PUBLIC_BASE_URL",
      "default": "https://sight.cero-ai.com"
    },
    {
      "key": "WORKER_ROLE_DELIVERY",
      "default": "1"
    },
    {
      "key": "WORKER_ROLE_SCHEDULER",
      "default": "1"
    },
    {
      "key": "SCHEDULER_ENABLED",
      "default": "1"
    },
    {
      "key": "WORKER_HEARTBEAT_FILE",
      "default": "/tmp/sight-worker-heartbeat"
    },
    {
      "key": "WORKER_SHUTDOWN_TIMEOUT_MS",
      "default": "25000"
    },
    {
      "key": "SCAN_ARTIFACT_RETENTION_MS",
      "default": "172800000"
    },
    {
      "key": "RESEND_API_KEY",
      "required": true,
      "secret": true
    },
    {
      "key": "EMAIL_FROM",
      "default": "Sight <reports@cero-ai.com>"
    },
    {
      "key": "REPORT_OPS_EMAIL",
      "description": "Operator mailbox for paid one-time report generation failures.",
      "required": true
    },
    {
      "key": "DELIVERY_OUTBOX_ENCRYPTION_KEY",
      "description": "Base64-encoded 32-byte key shared with the API.",
      "required": true,
      "secret": true
    },
    {
      "key": "WEBHOOK_SECRET_ENCRYPTION_KEY",
      "description": "Base64-encoded 32-byte key shared with the API for customer webhook secrets.",
      "required": true,
      "secret": true
    },
    {
      "key": "STRIPE_SECRET_KEY",
      "description": "Used by durable Stripe inbox recovery and billing fulfillment.",
      "required": true,
      "secret": true
    },
    {
      "key": "REFERRAL_REWARDS_ENABLED",
      "default": "0"
    },
    {
      "key": "SCAN_ARTIFACT_STORE",
      "default": "ocd"
    },
    {
      "key": "LOG_FORMAT",
      "default": "json"
    },
    {
      "key": "LOG_LEVEL",
      "default": "info"
    },
    {
      "key": "OCD_STORAGE_URL",
      "required": true
    },
    {
      "key": "OCD_STORAGE_TOKEN",
      "required": true,
      "secret": true
    }
  ],
  "volume": null,
  "public": false,
  "health_check": {
    "mode": "heartbeat",
    "file": "/tmp/sight-worker-heartbeat",
    "max_age_seconds": 90
  },
  "suggested_app_name": "sight-ops-worker",
  "replicas": 1,
  "memory_mb": 1536,
  "cpu_limit": 1,
  "image": "ghcr.io/0-ai-ug/ocd-storage-apps@sha256:29dccc08c82c6d26abd3bfe6fc3747042e679b26a20ff64ed0cd526f11ecc506",
  "env_projection": [
    "DATABASE_URL",
    "NODE_ENV",
    "PUBLIC_BASE_URL",
    "WORKER_ROLE_DELIVERY",
    "WORKER_ROLE_SCHEDULER",
    "WORKER_ROLES",
    "SCHEDULER_ENABLED",
    "WORKER_HEARTBEAT_FILE",
    "WORKER_SHUTDOWN_TIMEOUT_MS",
    "SCAN_ARTIFACT_RETENTION_MS",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "REPORT_OPS_EMAIL",
    "DELIVERY_OUTBOX_ENCRYPTION_KEY",
    "WEBHOOK_SECRET_ENCRYPTION_KEY",
    "STRIPE_SECRET_KEY",
    "LOG_FORMAT",
    "LOG_LEVEL",
    "SCAN_ARTIFACT_STORE",
    "OCD_STORAGE_URL",
    "OCD_STORAGE_TOKEN",
    "DATABASE_POOL_MAX"
  ]
}
