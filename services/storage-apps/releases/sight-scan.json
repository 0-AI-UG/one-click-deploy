{
  "$schema": 1,
  "name": "Sight Scan Worker",
  "description": "Private PGMQ consumers for crawl, analysis, and export workloads.",
  "container_port": 3000,
  "env": [
    {
      "key": "OCD_DEPLOY_TARGET",
      "default": "production"
    },
    {
      "key": "NODE_ENV",
      "default": "production"
    },
    {
      "key": "PUBLIC_BASE_URL",
      "default": "https://sight.cero-ai.com"
    },
    {
      "key": "WORKER_ROLE_SCAN",
      "default": "1"
    },
    {
      "key": "WORKER_CONCURRENCY",
      "default": "3"
    },
    {
      "key": "GEO_PROBE_CONCURRENCY",
      "default": "16",
      "description": "Maximum concurrent model calls within one GEO visibility run."
    },
    {
      "key": "WORKER_HEARTBEAT_FILE",
      "default": "/tmp/sight-worker-heartbeat"
    },
    {
      "key": "WORKER_SHUTDOWN_TIMEOUT_MS",
      "default": "25000"
    },
    {
      "key": "RENDERER_URL",
      "required": true
    },
    {
      "key": "RENDERER_TOKEN",
      "required": true,
      "secret": true
    },
    {
      "key": "SCAN_ARTIFACT_STORE",
      "default": "ocd"
    },
    {
      "key": "LLM_PROVIDER",
      "default": "openrouter"
    },
    {
      "key": "LLM_MODEL",
      "description": "Optional global model override. Leave unset to use each OpenRouter model role."
    },
    {
      "key": "PROBE_MODELS",
      "default": "anthropic/claude-sonnet-5,google/gemini-3.7-flash,openai/gpt-5.6-luna,perplexity/sonar"
    },
    {
      "key": "DEEPSEEK_API_KEY",
      "description": "Optional credential for direct DeepSeek routing.",
      "secret": true
    },
    {
      "key": "OPENROUTER_API_KEY",
      "description": "OpenRouter credential used by all scan and analysis model roles.",
      "required": true,
      "secret": true
    },
    {
      "key": "PSI_API_KEY",
      "description": "Google PageSpeed Insights API key.",
      "secret": true
    },
    {
      "key": "BRAVE_SEARCH_API_KEY",
      "secret": true
    },
    {
      "key": "BRIGHT_DATA_API_KEY",
      "description": "Server-side credential for managed answer-engine collection.",
      "secret": true
    },
    {
      "key": "BRIGHT_DATA_SERP_ZONE",
      "description": "SERP API zone used for Google AI Overview observations."
    },
    {
      "key": "BRIGHT_DATA_COST_CENTS_PER_RECORD",
      "default": "0.15"
    },
    {
      "key": "BRIGHT_DATA_CHATGPT_DATASET_ID",
      "default": "gd_m7aof0k82r803d5bjm"
    },
    {
      "key": "BRIGHT_DATA_PERPLEXITY_DATASET_ID"
    },
    {
      "key": "BRIGHT_DATA_GEMINI_DATASET_ID"
    },
    {
      "key": "BRIGHT_DATA_GOOGLE_AI_MODE_DATASET_ID",
      "default": "gd_mcswdt6z2elth3zqr2"
    },
    {
      "key": "BRIGHT_DATA_COPILOT_DATASET_ID"
    },
    {
      "key": "BRIGHT_DATA_GROK_DATASET_ID"
    },
    {
      "key": "LOG_FORMAT",
      "default": "json"
    },
    {
      "key": "LOG_LEVEL",
      "default": "info"
    },
    {
      "key": "REDIS_MAXMEMORY_BYTES",
      "default": "1073741824"
    },
    {
      "key": "REDIS_MAXMEMORY_POLICY",
      "default": "volatile-lfu"
    },
    {
      "key": "OCD_STORAGE_URL",
      "required": true
    },
    {
      "key": "OCD_STORAGE_TOKEN",
      "required": true,
      "secret": true
    }
  ],
  "volume": null,
  "public": false,
  "health_check": {
    "mode": "heartbeat",
    "file": "/tmp/sight-worker-heartbeat",
    "max_age_seconds": 90
  },
  "suggested_app_name": "sight-scan-worker",
  "replicas": 2,
  "memory_mb": 4096,
  "cpu_limit": 2,
  "image": "ghcr.io/0-ai-ug/ocd-storage-apps@sha256:29dccc08c82c6d26abd3bfe6fc3747042e679b26a20ff64ed0cd526f11ecc506",
  "env_projection": [
    "DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "PUBLIC_BASE_URL",
    "WORKER_ROLE_SCAN",
    "WORKER_CONCURRENCY",
    "GEO_PROBE_CONCURRENCY",
    "WORKER_HEARTBEAT_FILE",
    "WORKER_SHUTDOWN_TIMEOUT_MS",
    "RENDERER_URL",
    "RENDERER_TOKEN",
    "SCAN_ARTIFACT_STORE",
    "LLM_PROVIDER",
    "LLM_MODEL",
    "PROBE_MODELS",
    "DEEPSEEK_API_KEY",
    "OPENROUTER_API_KEY",
    "BRAVE_SEARCH_API_KEY",
    "PSI_API_KEY",
    "BRIGHT_DATA_API_KEY",
    "BRIGHT_DATA_SERP_ZONE",
    "BRIGHT_DATA_COST_CENTS_PER_RECORD",
    "BRIGHT_DATA_CHATGPT_DATASET_ID",
    "BRIGHT_DATA_PERPLEXITY_DATASET_ID",
    "BRIGHT_DATA_GEMINI_DATASET_ID",
    "BRIGHT_DATA_GOOGLE_AI_MODE_DATASET_ID",
    "BRIGHT_DATA_COPILOT_DATASET_ID",
    "BRIGHT_DATA_GROK_DATASET_ID",
    "LOG_FORMAT",
    "LOG_LEVEL",
    "REDIS_MAXMEMORY_BYTES",
    "REDIS_MAXMEMORY_POLICY",
    "OCD_STORAGE_URL",
    "OCD_STORAGE_TOKEN",
    "DATABASE_POOL_MAX"
  ]
}
