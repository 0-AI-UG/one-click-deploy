{
  "$schema": 1,
  "name": "Sight Docs",
  "description": "Public documentation, help center, agent index, and MCP endpoint for Sight.",
  "container_port": 3000,
  "env": [
    {
      "key": "OCD_DEPLOY_TARGET",
      "default": "production"
    },
    {
      "key": "NODE_ENV",
      "default": "production"
    },
    {
      "key": "DOCS_DATABASE_URL",
      "description": "Project-scoped connection to the dedicated sight_docs database in shared OCD PostgreSQL.",
      "required": true,
      "secret": true
    }
  ],
  "volume": null,
  "public": true,
  "health_check": {
    "path": "/"
  },
  "suggested_app_name": "sight-support-docs",
  "replicas": 1,
  "memory_mb": 1024,
  "cpu_limit": 1,
  "compress": true,
  "image": "ghcr.io/0-ai-ug/sight/sight-support-docs@sha256:a251bde80d00401f9422a7ed544efcc9985d1e926de15c1ee592f5505dacf73e",
  "environment": "sight-production",
  "env_projection": [
    "DOCSDB_URL",
    "NODE_ENV",
    "DOCS_DATABASE_URL"
  ]
}
