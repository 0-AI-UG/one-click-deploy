{
  "$schema": 1,
  "name": "Sight Renderer",
  "description": "Private, sandboxed Chromium service for queued artifacts, hostile-site rendering, and lab vitals.",
  "container_port": 3000,
  "env": [
    {
      "key": "OCD_DEPLOY_TARGET",
      "default": "production"
    },
    {
      "key": "NODE_ENV",
      "default": "production"
    },
    {
      "key": "PORT",
      "default": "3000"
    },
    {
      "key": "PUBLIC_BASE_URL",
      "default": "https://sight.cero-ai.com",
      "description": "Canonical HTTPS origin required by shared production configuration."
    },
    {
      "key": "DATABASE_URL",
      "description": "Production PostgreSQL/PGMQ URL used only for durable browser jobs.",
      "required": true,
      "secret": true
    },
    {
      "key": "REDIS_URL",
      "description": "Production Redis URL used for generated PDF and PNG artifacts.",
      "required": true,
      "secret": true
    },
    {
      "key": "RENDERER_TOKEN",
      "description": "Dedicated bearer token used only by Sight API and worker clients; at least 32 characters.",
      "required": true,
      "secret": true
    },
    {
      "key": "RENDERER_EGRESS_PROXY_URL",
      "default": "http://sight-support-renderer-egress.ocd.internal:3128",
      "description": "Private support-stack Squid endpoint; overrides the automatically injected dependency URL when OCD does not publish TCP app URLs."
    },
    {
      "key": "RENDERER_EGRESS_URL",
      "description": "Automatically injected URL of the support-stack egress proxy."
    }
  ],
  "volume": null,
  "public": false,
  "health_check": {
    "path": "/readyz"
  },
  "suggested_app_name": "sight-support-renderer",
  "replicas": 2,
  "memory_mb": 2048,
  "cpu_limit": 2,
  "image": "ghcr.io/0-ai-ug/sight/sight-support-renderer@sha256:668790bf3adcce9bb2ed026a65235b50d64ff3c32edcfdedf98bb45e85e3f5c9",
  "environment": "sight-production",
  "env_projection": [
    "NODE_ENV",
    "PORT",
    "PUBLIC_BASE_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "RENDERER_TOKEN",
    "RENDERER_EGRESS_PROXY_URL",
    "RENDERER_EGRESS_URL"
  ]
}
