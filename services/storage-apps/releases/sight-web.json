{
  "$schema": 1,
  "name": "Sight API",
  "description": "Public HTTP API and React applications for Sight.",
  "container_port": 3000,
  "env": [
    {
      "key": "OCD_DEPLOY_TARGET",
      "default": "production"
    },
    {
      "key": "NODE_ENV",
      "default": "production"
    },
    {
      "key": "PORT",
      "default": "3000"
    },
    {
      "key": "PUBLIC_BASE_URL",
      "default": "https://sight.cero-ai.com"
    },
    {
      "key": "ADMIN_CHECKOUT_QA_URL",
      "description": "Optional deployed Stripe sandbox environment linked from the admin billing lab."
    },
    {
      "key": "SCAN_ARTIFACT_STORE",
      "default": "ocd"
    },
    {
      "key": "RENDERER_URL",
      "description": "Private URL of the separately deployed Sight Renderer service.",
      "required": true
    },
    {
      "key": "RENDERER_TOKEN",
      "description": "Dedicated bearer token shared only with the Sight Renderer service.",
      "required": true,
      "secret": true
    },
    {
      "key": "DATA_DIR",
      "default": "/tmp/sight-data"
    },
    {
      "key": "RESEND_API_KEY",
      "description": "Resend API key for transactional and billing email.",
      "required": true,
      "secret": true
    },
    {
      "key": "EMAIL_FROM",
      "default": "Sight <reports@cero-ai.com>"
    },
    {
      "key": "DELIVERY_OUTBOX_ENCRYPTION_KEY",
      "description": "Base64-encoded 32-byte key shared with delivery and scheduler workers.",
      "required": true,
      "secret": true
    },
    {
      "key": "JWT_SECRET",
      "description": "Secret used to sign login sessions and report access proofs.",
      "required": true,
      "secret": true
    },
    {
      "key": "CRAWL_INSIGHTS_SECRET_ENCRYPTION_KEY",
      "description": "Base64-encoded 32-byte key used to encrypt crawl-provider secrets.",
      "required": true,
      "secret": true
    },
    {
      "key": "GOOGLE_SEARCH_CONSOLE_CLIENT_ID",
      "description": "OAuth client ID for the Google Search Console integration.",
      "required": true
    },
    {
      "key": "GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET",
      "description": "OAuth client secret for the Google Search Console integration.",
      "required": true,
      "secret": true
    },
    {
      "key": "GOOGLE_SEARCH_CONSOLE_TOKEN_ENCRYPTION_KEY",
      "description": "Base64-encoded 32-byte key used to encrypt Google Search Console OAuth tokens.",
      "required": true,
      "secret": true
    },
    {
      "key": "OPENROUTER_API_KEY",
      "description": "OpenRouter credential used by Sight Agent routes.",
      "required": true,
      "secret": true
    },
    {
      "key": "BRAVE_SEARCH_API_KEY",
      "description": "Optional independent-index provider for keyword, competitor, and source discovery.",
      "secret": true
    },
    {
      "key": "BRIGHT_DATA_API_KEY",
      "description": "Server-side credential for exact Google SERP and managed answer-engine observations.",
      "secret": true
    },
    {
      "key": "BRIGHT_DATA_SERP_ZONE",
      "description": "SERP API zone used for exact Google and AI Overview observations."
    },
    {
      "key": "LLM_PROVIDER",
      "default": "openrouter"
    },
    {
      "key": "LLM_MODEL",
      "description": "Optional global model override. Leave unset to use each OpenRouter model role."
    },
    {
      "key": "PROBE_MODELS",
      "default": "anthropic/claude-sonnet-5,google/gemini-3.7-flash,openai/gpt-5.6-luna,perplexity/sonar"
    },
    {
      "key": "QUESTION_MODEL",
      "default": "google/gemini-2.5-flash"
    },
    {
      "key": "AGENT_TITLE_MODEL",
      "default": "openai/gpt-4o-mini"
    },
    {
      "key": "WEBHOOK_SECRET_ENCRYPTION_KEY",
      "description": "Base64-encoded 32-byte key used to encrypt customer webhook signing secrets.",
      "required": true,
      "secret": true
    },
    {
      "key": "LOG_FORMAT",
      "default": "json"
    },
    {
      "key": "LOG_LEVEL",
      "default": "info"
    },
    {
      "key": "REDIS_MAXMEMORY_BYTES",
      "default": "1073741824"
    },
    {
      "key": "REDIS_MAXMEMORY_POLICY",
      "default": "volatile-lfu"
    },
    {
      "key": "TRUSTED_PROXY_COUNT",
      "default": "1"
    },
    {
      "key": "STRIPE_SECRET_KEY",
      "description": "Stripe API secret key.",
      "required": true,
      "secret": true
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "description": "Signing secret for the production Stripe webhook endpoint.",
      "required": true,
      "secret": true
    },
    {
      "key": "STRIPE_PUBLISHABLE_KEY",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_REPORT_SEO",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_REPORT_GEO",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_REPORT_FULL",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_ONETIME",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_STARTER",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_GROWTH",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_SCALE",
      "required": true
    },
    {
      "key": "STRIPE_PRICE_BUSINESS",
      "required": true
    },
    {
      "key": "STRIPE_REFERRAL_COUPON_ID",
      "description": "Stripe coupon used only when REFERRAL_DISCOUNTS_ENABLED is explicitly enabled."
    },
    {
      "key": "REFERRAL_ENROLLMENT_ENABLED",
      "default": "0"
    },
    {
      "key": "REFERRAL_DISCOUNTS_ENABLED",
      "default": "0"
    },
    {
      "key": "REFERRAL_PAYOUTS_ENABLED",
      "default": "0"
    },
    {
      "key": "OPS_MONITOR_TOKEN",
      "description": "Bearer token for the private detailed operations health endpoint.",
      "required": true,
      "secret": true
    },
    {
      "key": "OCD_STORAGE_URL",
      "required": true
    },
    {
      "key": "OCD_STORAGE_TOKEN",
      "required": true,
      "secret": true
    }
  ],
  "volume": null,
  "health_check": {
    "path": "/readyz"
  },
  "suggested_app_name": "sight-web",
  "replicas": 2,
  "public": true,
  "memory_mb": 1536,
  "cpu_limit": 2,
  "compress": true,
  "image": "ghcr.io/0-ai-ug/ocd-storage-apps@sha256:21ad5c703f22c3180ea0e0884fa06cb09dc838be81305533d1518d75fe1e137f",
  "env_projection": [
    "DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "PORT",
    "PUBLIC_BASE_URL",
    "ADMIN_CHECKOUT_QA_URL",
    "SCAN_ARTIFACT_STORE",
    "RENDERER_URL",
    "RENDERER_TOKEN",
    "DATA_DIR",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "DELIVERY_OUTBOX_ENCRYPTION_KEY",
    "JWT_SECRET",
    "CRAWL_INSIGHTS_SECRET_ENCRYPTION_KEY",
    "GOOGLE_SEARCH_CONSOLE_CLIENT_ID",
    "GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET",
    "GOOGLE_SEARCH_CONSOLE_TOKEN_ENCRYPTION_KEY",
    "OPENROUTER_API_KEY",
    "BRAVE_SEARCH_API_KEY",
    "BRIGHT_DATA_API_KEY",
    "BRIGHT_DATA_SERP_ZONE",
    "LLM_PROVIDER",
    "LLM_MODEL",
    "PROBE_MODELS",
    "QUESTION_MODEL",
    "AGENT_TITLE_MODEL",
    "WEBHOOK_SECRET_ENCRYPTION_KEY",
    "LOG_FORMAT",
    "LOG_LEVEL",
    "REDIS_MAXMEMORY_BYTES",
    "REDIS_MAXMEMORY_POLICY",
    "TRUSTED_PROXY_COUNT",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_PRICE_REPORT_SEO",
    "STRIPE_PRICE_REPORT_GEO",
    "STRIPE_PRICE_REPORT_FULL",
    "STRIPE_PRICE_ONETIME",
    "STRIPE_PRICE_STARTER",
    "STRIPE_PRICE_GROWTH",
    "STRIPE_PRICE_SCALE",
    "STRIPE_PRICE_BUSINESS",
    "STRIPE_REFERRAL_COUPON_ID",
    "OPS_MONITOR_TOKEN",
    "OCD_STORAGE_URL",
    "OCD_STORAGE_TOKEN",
    "DATABASE_POOL_MAX"
  ]
}
