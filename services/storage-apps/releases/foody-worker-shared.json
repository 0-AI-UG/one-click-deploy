    "DEEPSEEK_CATALOG_MODEL",
    "DEEPSEEK_SHELF_LIFE_MODEL",
    "OPENROUTER_API_KEY",
    "OPENROUTER_BASE_URL",
    "OPENROUTER_CAPTURE_MODEL",
    "RECEIPT_VISION_TIMEOUT_MS",
    "WORKER_MAX_ATTEMPTS",
    "WORKER_POLL_MS",
    "CATALOG_ON_DEMAND_MAX_ATTEMPTS",
    "APPLE_APP_ID",
    "ENFORCE_SUBSCRIPTION_LIMITS",
    "APNS_TEAM_ID",
    "NOTIFICATIONS_ENABLED",
    "OPENROUTER_RECIPE_TRANSLATION_MODEL",
    "CAPTURE_WORKER_CONCURRENCY",
    "CATALOG_WORKER_CONCURRENCY",
    "SHELF_LIFE_ON_DEMAND_PROVIDER_ATTEMPTS",
