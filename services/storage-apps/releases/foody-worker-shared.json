    "WEBSITE_URL",
    "OPENROUTER_ADMIN_RECIPE_MODEL",
    "OPENAI_ADMIN_CATALOG_MODEL",
    "IDENTITY_EMAIL_VERIFICATION_URL_BASE",
    "IDENTITY_PASSWORD_RESET_URL_BASE",
    "OCD_STORAGE_URL",
    "OCD_STORAGE_TOKEN",
    "OPENROUTER_RECIPE_IMPORT_MODEL",
    "RECIPE_IMPORT_TIMEOUT_MS",
    "WORKER_BULK_CONCURRENCY",
    "WORKER_CRITICAL_CONCURRENCY",
    "WORKER_INTERACTIVE_CONCURRENCY",
    "WORKER_MAINTENANCE_CONCURRENCY",
    "STORAGE_DRIVER",
    "DATABASE_URL"
  ]
}
