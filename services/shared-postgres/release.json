{
  "$schema": 1,
  "name": "Shared PostgreSQL",
  "description": "Shared PostgreSQL 17 with PGMQ, PostGIS and pgvector; separate databases and roles per project.",
  "container_port": 5432,
  "public": false,
  "internal_protocol": "tcp",
  "env": {
    "POSTGRES_USER": {
      "from": "environment.POSTGRES_USER"
    },
    "POSTGRES_PASSWORD": {
      "from": "environment.POSTGRES_PASSWORD"
    },
    "POSTGRES_DB": {
      "from": "environment.POSTGRES_DB"
    },
    "PGDATA": {
      "from": "environment.PGDATA"
    },
    "FOODY_ROLE_PASSWORD": {
      "from": "environment.FOODY_ROLE_PASSWORD"
    },
    "BACKUP_ROLE_PASSWORD": {
      "from": "environment.BACKUP_ROLE_PASSWORD"
    },
    "SKYLINE_ROLE_PASSWORD": {
      "from": "environment.SKYLINE_ROLE_PASSWORD"
    },
    "DOCS_ROLE_PASSWORD": {
      "from": "environment.DOCS_ROLE_PASSWORD"
    },
    "SIGHT_ROLE_PASSWORD": {
      "from": "environment.SIGHT_ROLE_PASSWORD"
    }
  },
  "volume": {
    "size": 10,
    "path": "/var/lib/postgresql/data",
    "driver": "local-directory"
  },
  "memory_mb": 2048,
  "replicas": 1,
  "health_check": {
    "mode": "exec",
    "command": "pg_isready -U postgres -d postgres"
  },
  "image": "ghcr.io/0-ai-ug/ocd-shared-postgres@sha256:e43f62150d6e35bf1dd219f8f54542be6a5db818f5e374e51d8975b306238544",
  "environment": "shared-data",
  "suggested_app_name": "ocd-shared-postgres",
  "outputs": {
    "HOST": {
      "template": "{app.host}"
    },
    "PORT": {
      "template": "{app.port}"
    }
  }
}
