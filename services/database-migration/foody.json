{
  "$schema": 1,
  "name": "foody database rehearsal",
  "image": "ghcr.io/0-ai-ug/ocd-postgres-backup@sha256:e324ec538988e2beaa9ad857a8105e840b30b7ab28c972d81483bd233081f748",
  "environment": "foody-production",
  "env_projection": [
    "DATABASE_URL",
    "SHARED_DATABASE_URL"
  ],
  "command": [
    "bun",
    "/app/migrate.ts",
    "foody",
    "rehearsal"
  ],
  "volume": null,
  "public": false,
  "container_port": 3000,
  "replicas": 1,
  "memory_mb": 1024,
  "health_check": {
    "mode": "exec",
    "command": "test -f /app/migrate.ts"
  },
  "suggested_app_name": "foody-database-rehearsal"
}
