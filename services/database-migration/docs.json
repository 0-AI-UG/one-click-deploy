{
  "$schema": 1,
  "name": "docs database rehearsal",
  "image": "ghcr.io/0-ai-ug/ocd-postgres-backup@sha256:4dbb898457d57cc8b05e50a30d4bc442842ca854c74459374b1dbe7a1466bcde",
  "environment": "sight-production",
  "env_projection": [
    "DOCSDB_URL",
    "SHARED_DOCS_DATABASE_URL"
  ],
  "command": [
    "bun",
    "/app/migrate.ts",
    "docs",
    "rehearsal"
  ],
  "volume": null,
  "public": false,
  "container_port": 3000,
  "replicas": 1,
  "memory_mb": 1024,
  "health_check": {
    "mode": "exec",
    "command": "test ! -f /tmp/migration-failed"
  },
  "suggested_app_name": "docs-database-rehearsal"
}
